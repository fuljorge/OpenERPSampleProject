# Aponta para o cluster de TESTE dedicado do Atlas (mongodbEnvironments/test_atlas-credentials.env)
# — nunca o de dev nem o de prod. Testes E2E criam dados reais (usuários com e-mail com
# timestamp, para não colidir entre execuções) nesse banco.
MONGODB_URI=

# Segredos próprios do ambiente de E2E — não reaproveitar os de dev/prod.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Credenciais do admin de fixture, criado (idempotente) pelo global-setup.ts antes dos testes
# rodarem. Fixas e conhecidas — é um banco de teste, não há dado sensível real aqui.
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=e2e-admin-senha-123

# Mesma Storage Account de dev/prod (ADR-003) — só o container muda por ambiente.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=product-images-test

# Chave-mestra própria do ambiente de teste (ADR-021) — nunca reaproveitar a de dev/prod. Gerar
# uma vez: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Protege tanto credenciais de marketplace (ainda sem specs de e2e) quanto (spec 013) a API key
# de IA que o global-setup.ts cifra e grava em ai_settings a partir de AI_API_KEY abaixo.
MARKETPLACE_CREDENTIAL_MASTER_KEY=

# Mesmo provedor/credencial de dev (backend/.env.example). global-setup.ts semeia essa
# configuração em ai_settings (spec 013) antes dos specs rodarem — o backend não lê mais estas
# variáveis diretamente (só o global-setup.ts, pra semear). Specs de 006 chamam
# POST /products/analyze de verdade (sem mock de adapter), custo real por execução.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
