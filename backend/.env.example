NODE_ENV=development
PORT=3333

# Se der "querySrv ECONNREFUSED _mongodb._tcp...." ao rodar o backend: seu DNS/roteador não
# suporta registros SRV (comum em algumas redes domésticas/ISP). Duas saídas:
# 1) Trocar o DNS da máquina para 8.8.8.8 (Google) ou 1.1.1.1 (Cloudflare) — resolve a
#    maioria dos casos.
# 2) Se isso não resolver, troque mongodb+srv://usuario:senha@cluster.mongodb.net por uma
#    connection string "expandida" sem SRV: no Atlas, Connect → Drivers → copie a URI SRV, e
#    troque `mongodb+srv://` por `mongodb://`, liste os 3 hosts de shard (visíveis com
#    `nslookup -type=SRV _mongodb._tcp.<cluster>.mongodb.net`) separados por vírgula, cada um
#    com `:27017`, e acrescente `?ssl=true&authSource=admin&replicaSet=<nome, via
#    nslookup -type=TXT <cluster>.mongodb.net>` no final.
MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Provedor de IA — compatível com qualquer API no formato OpenAI Chat Completions
# (OpenAI, OpenRouter, Azure OpenAI em modo compatível, Groq, vLLM, Ollama, LM Studio etc.)
AI_API_KEY=
# Deixe em branco para usar a OpenAI oficial (https://api.openai.com/v1); ou aponte para o
# endpoint compatível do provedor escolhido, ex.: https://openrouter.ai/api/v1
AI_BASE_URL=
# Identificador do modelo no provedor escolhido, ex.: gpt-4o-mini, gpt-4o
AI_MODEL=

# Uma única Storage Account para todos os ambientes — a connection string é a mesma em
# dev/test/prod, só o nome do container muda (ver ADR-003 em memory/decisions.md).
AZURE_STORAGE_CONNECTION_STRING=
# product-images-dev | product-images-test | product-images-prod, conforme o ambiente
AZURE_STORAGE_CONTAINER_NAME=product-images-dev

FRONTEND_URL=http://localhost:5173

# Chave-mestra (32 bytes em base64) que protege as chaves de criptografia das credenciais de
# marketplace (spec 011, seção 3.1; ADR-021). É a ÚNICA chave que fica fora do banco: as chaves que
# de fato cifram as credenciais são geradas sozinhas pela aplicação e guardadas no banco já cifradas
# por esta. Gerar (uma vez por ambiente; dev, teste e produção com valores diferentes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia em um cofre de senhas. Se ela se perder ou for trocada, as chaves no
# banco não abrem mais e as contas de marketplace precisam ser recadastradas. A rotação das chaves de criptografia é feita pelo botão
# "Rotacionar chave de criptografia" na tela de contas de marketplace — não por esta variável.
MARKETPLACE_CREDENTIAL_MASTER_KEY=


# Usadas só pelo script `npm run seed:admin` (bootstrap do primeiro usuário admin — ver
# ADR-004 em memory/decisions.md), nunca lidas pelo servidor. SEED_ADMIN_PASSWORD é opcional:
# se omitida, o script gera uma senha temporária e imprime uma única vez.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Conector Mercado Livre (spec 012). `client_id`/`client_secret` NÃO ficam aqui — são digitados
# pelo admin no cadastro de cada conta de marketplace (uma app do Mercado Livre por conta) e vão
# cifrados para o banco (ver mercado-livre-credential.schema.ts).

# Só tem efeito fora de produção (E2E com servidor falso); em produção o cliente sempre usa
# https://api.mercadolibre.com, mesmo que esta variável esteja definida.
MERCADO_LIVRE_API_BASE_URL=

# O pacote padrão do Mercado Envios 2 (spec 012, seção 3.4; ADR-027) NÃO é uma variável de
# ambiente — é editado pelo admin em "Contas de marketplace → Pacote padrão do Mercado Livre" e
# gravado no banco.
